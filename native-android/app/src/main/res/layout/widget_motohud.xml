<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_motohud_background">

    <FrameLayout
        android:id="@+id/widget_top_bar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="#10B981" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MotoHUD"
                android:textColor="#E4E4E7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS OFF"
                android:textColor="#A1A1AA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_speed"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="76sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="40sp"
                android:autoSizeMaxTextSize="180sp"
                android:autoSizeStepGranularity="4sp"
                android:maxLines="1"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textColor="#D4D4D8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_zone_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="#27272A">

            <TextView
                android:id="@+id/widget_zone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="TAP TO START GPS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
